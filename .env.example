# ── Supabase (required) ─────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → Project API keys → service_role (KEEP SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI (Settings → Database → Connection string → URI) for `npm run migrate`
DATABASE_URL=
# Alternate names supported as fallbacks (new-format keys from feat/backend):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ── Admin seed (used by `npm run seed:admin`) ───────────────────────
SEED_ADMIN_EMAIL=admin@facultyos.edu
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator

# ── Gemini (P3 tool calling) ────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Groq (Faculty chatbot) ──────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── App flags ───────────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK=true

# ── Email / SMTP (invite & verification emails) ─────────────────────
# Public base URL used to build verification links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SMTP transport (e.g. Gmail: host=smtp.gmail.com, port=465, user=your address,
# pass=an App Password — NOT your normal password). SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FacultyOS <no-reply@facultyos.edu>"
